# Copy to .env and fill in. Never commit .env.
PORT=5001
CLIENT_URL=http://localhost:4200

# Local: mongodb://localhost:27017/calorie-tracker   Production: your MongoDB Atlas connection string
MONGODB_URI=

# Required. Any long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# Python virtualenv and ML folder (macOS/Linux shown; the Docker image sets these itself)
PYTHON_PATH=./ml/venv/bin/python
ML_DIR=./ml

# macOS without Homebrew's libomp only: let XGBoost use the copy bundled with scikit-learn
# DYLD_FALLBACK_LIBRARY_PATH=./ml/venv/lib/python3.9/site-packages/sklearn/.dylibs
